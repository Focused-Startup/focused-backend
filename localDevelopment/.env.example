# Copy this file to `localDevelopment/.env` and adjust if you changed the
# defaults in Dockerfile / docker-compose.yml. docker-compose automatically
# loads a `.env` file from the same directory as the compose file.

MYSQL_DATABASE=focused_dev
MYSQL_USER=focused
MYSQL_PASSWORD=focused
MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=3306

# Used by `prisma db push` inside the seed container (datasource URL) and by
# the backend when you run it locally against this container (see
# README.md "Local Database" section). Host is 127.0.0.1/port 3306 when
# connecting from your host machine; the seed container instead overrides
# this to use the `db` service hostname (see docker-compose.yml).
DATABASE_URL="mysql://focused:focused@127.0.0.1:3306/focused_dev"

# Discrete connection params, mirrored from DATABASE_URL, consumed by
# src/db/client.ts's PrismaMariaDb adapter (it does not read DATABASE_URL).
DATABASE_HOST=127.0.0.1
DATABASE_USER=focused
DATABASE_PASSWORD=focused
DATABASE_NAME=focused_dev
